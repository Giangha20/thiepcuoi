# Database connection (SQLite local out of the box, or PostgreSQL / Supabase)
DATABASE_URL="file:./dev.db"

# Admin Authentication Secret Key
JWT_SECRET="your-secure-jwt-secret-key-change-in-production"

# Base URL (for sharing and QR codes)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Supabase configuration (for production image storage & managed PostgreSQL)
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
